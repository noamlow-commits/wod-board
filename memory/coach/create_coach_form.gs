/**
 * יוצר את טופס Google Forms "שאלון קצר על כתיבת האימון בגיליון" (2.10.2026).
 *
 * איך מריצים (פעם אחת):
 *  1. נכנסים ל-https://script.google.com ולוחצים "פרויקט חדש".
 *  2. מוחקים את כל מה שכתוב שם ומדביקים את כל הקובץ הזה.
 *  3. בוחרים למעלה את הפונקציה createCoachForm ולוחצים "הפעלה" (▶).
 *  4. בהרצה הראשונה Google מבקש הרשאה. מאשרים עם החשבון שלך.
 *  5. בתחתית המסך, ב"יומן ביצוע", מופיעים שני קישורים:
 *     – קישור למילוי: את הקישור הזה שולחים למאמנת.
 *     – קישור לעריכה: את הקישור הזה שומרים לעצמך. שם רואים את התשובות.
 */
function createCoachForm() {
  const form = FormApp.create('שאלון קצר על כתיבת האימון בגיליון');
  form.setDescription(
    'היי! הלוח בבוקס קורא את מה שאת כותבת בגיליון ומחליט לבד איזה שעון להפעיל. ' +
    'בדרך כלל זה עובד, אבל יש כמה מקרים שבהם אנחנו לא בטוחים מה התכוונת. במקרים כאלה ' +
    'אנחנו לא רוצים לנחש: שעון שגוי על הקיר יותר גרוע משעון שלא מופיע בכלל.\n\n' +
    'זה לוקח בערך 5 דקות. אפשר לבחור תשובה, או לכתוב משהו משלך ב"אחר". תודה! 🙏'
  );
  form.setCollectEmail(false);
  form.setProgressBar(true);

  const q = (title, help, choices) => {
    form.addMultipleChoiceItem()
      .setTitle(title)
      .setHelpText(help)
      .setChoiceValues(choices)
      .showOtherOption(true)
      .setRequired(false);
  };

  q('1. "time cap" או "cap" במקום t.c',
    'היום הלוח מזהה מגבלת זמן רק כשהיא כתובה "t.c 14", "tc 14" או "14 min tc".\n' +
    'אם כתוב "time cap 14" או "cap 14", הלוח מתעלם מזה, והשעון של ה-For Time רץ בלי מגבלה.\n\n' +
    'האם קורה שאת כותבת "time cap" או "cap" במקום t.c? אם כן, שהלוח יקרא את זה כמגבלת זמן?',
    ['כן, שיקרא את זה בדיוק כמו t.c', 'אני תמיד כותבת t.c, אין צורך']);

  q('2. מגבלת זמן באותו תא עם שעון אחר',
    'דוגמה: בתא אחד כתוב "AMRAP 10", מתחתיו תרגילים, ובסוף "16 min tc".\n' +
    'היום הלוח מציג רק את ה-AMRAP, וה-16 נעלם.\n\n' +
    'כשמגבלת זמן כתובה באותו תא עם שעון אחר, מה הכוונה?',
    ['זו מגבלה לכל הבלוק, כלומר שעון אחד', 'אלה שני דברים נפרדים, כלומר שני שעונים', 'זה לא קורה אצלי']);

  q('3. משך של בלוק בלי האות x',
    'כשכתוב "WARM UP x 6 min", הלוח מפעיל שעון של 6 דקות.\n' +
    'כשכתוב "WARM UP 6 min", בלי x, הלוח לא מפעיל שעון. הסיבה: לפעמים מספר כזה הוא רק הערכה כמה זמן ' +
    'החלק ייקח, ולא שעון שצריך להריץ. לדוגמה "A. Deadlift Prog-8 min".\n\n' +
    'כשאת רוצה שעון לבלוק, את תמיד כותבת את ה-x?',
    ['כן, ה-x אומר "תפעיל שעון"', 'לא תמיד, גם בלי x תפעיל שעון', 'זה משתנה']);

  q('4. "ואז" בתוך חלק',
    'דוגמה:\npart 2: amrap 14\n1000 m run\nואז amrap:\n\n' +
    'כאן הריצה בלי זמן, וה-AMRAP מתחיל רק כשמסיימים לרוץ. המילה "ואז" היא מה שאומר ללוח לא להתחיל ' +
    'את ה-AMRAP אוטומטית באמצע הריצה.\n\n' +
    'כשחלק מתחיל בעבודה בלי זמן ורק אחריה בא שעון, את תמיד כותבת "ואז" (או "and then")?',
    ['כן, תמיד', 'לא תמיד']);

  q('5. For Time בתוך שעון רציף',
    'כשאימון בנוי מכמה חלקים ברצף, למשל t.c 14, אחריו מנוחה 2:00, ואחריה AMRAP 14, הלוח יכול להריץ את הכול כשעון אחד.\n' +
    'אבל בשעון רציף, חלק ה-For Time סופר לאחור (מ-14:00 ל-0:00) ולא קדימה. מתאמן שסיים ב-11:32 ' +
    'יראה על הלוח 02:28 ויצטרך לחשב לבד את התוצאה שלו.\n\n' +
    'זה בסדר בשבילך, או שבחלק For Time הספירה חייבת לעלות?',
    ['בסדר, שעון אחד חשוב יותר', 'הספירה חייבת לעלות, עדיף שעונים נפרדים']);

  q('6. לפעמים שעון אחד ולפעמים שניים',
    'לפעמים הלוח מחבר כמה חלקים לשעון אחד רציף, ולפעמים הוא מציג לכל חלק שעון נפרד. זה תלוי באיך שהאימון כתוב.\n\n' +
    'זה מפריע לך?',
    ['לא מפריע', 'עדיף תמיד שעון נפרד לכל חלק', 'עדיף תמיד שעון אחד כשאפשר']);

  q('7. כפתור "⏭ הבא"',
    'בשעון רציף, המנוחה מתחילה בדיוק כשהזמן נגמר, גם אם כל הקבוצה סיימה קודם. ' +
    'כפתור ⏭ הבא בשלט (או המקש n) מקפיץ מיד לשלב הבא.\n\n' +
    'כשכולם סיימו לפני הזמן, איך את רוצה לעבור הלאה?',
    ['ללחוץ "הבא" זה מצוין', 'הייתי רוצה שזה יקרה לבד', 'אני נותנת לזמן לרוץ עד הסוף']);

  q('8. E2MOM עם מספר',
    'כשכתוב "E2MOM 6", האם הכוונה ל-6 דקות (כלומר 3 סבבים של 2 דקות) או ל-6 סבבים (כלומר 12 דקות)?\n' +
    'היום הלוח קורא את זה כ-6 דקות. כשכתוב "E2MOM x6", עם x, הלוח קורא את זה כ-6 סבבים.',
    ['המספר הוא דקות', 'המספר הוא סבבים', 'אני תמיד כותבת x כשאני מתכוונת לסבבים']);

  q('9. "30 rest" בלי יחידה',
    'כשכתוב "30 rest", בלי sec או min, הלוח מניח שמדובר ב-30 שניות.\n\n' +
    'מספר כזה ליד rest הוא תמיד שניות?',
    ['כן, תמיד שניות', 'לא תמיד, עדיף לכתוב יחידה']);

  q('10. "x 4 sets" כשיש תחנות',
    'דוגמה:\nevery 2:30 x 4 sets (10 min each)\nומתחת שלוש תחנות: 1#, 2#, 3#\n\n' +
    'היום הלוח מציג שעון של 4 סבבים בלבד, כלומר 10 דקות.\n\n' +
    'האם הכוונה ל-4 סבבים בכל תחנה (כלומר 12 סבבים ו-30 דקות) או ל-4 סבבים בסך הכול?',
    ['4 בכל תחנה (30 דקות)', '4 בסך הכול (10 דקות)']);

  q('11. מספר ואחריו מקף: תחנה או טווח?',
    'כשכתוב "1 - 400 m run", ה-1 הוא מספר התחנה. אבל כשכתוב "10 - 15 burpees", זה טווח חזרות.\n' +
    'כרגע הלוח לא מסמן מספר עם מקף כתחנה, כדי לא לבלבל בין השניים.\n\n' +
    'כשאת ממספרת תחנות, באיזה סימן את משתמשת?',
    ['נקודה (1.)', 'סולמית (1# או #1)', 'מקף (1 -)', 'משתנה']);

  q('12. חלקים עם אותיות',
    'הלוח מזהה "חלק 1", "חלק ראשון" ו-"Part 1".\n\n' +
    'האם קורה שאת כותבת "חלק א\'" או "חלק ב\'"?',
    ['כן', 'לא']);

  form.addParagraphTextItem()
    .setTitle('עוד משהו?')
    .setHelpText('דברים שהלוח עושה ומפריעים לך, דוגמה מהגיליון, או כל הערה אחרת.')
    .setRequired(false);

  Logger.log('קישור למילוי (לשלוח למאמנת): ' + form.getPublishedUrl());
  Logger.log('קישור לעריכה ולתשובות (לשמור לעצמך): ' + form.getEditUrl());
}
